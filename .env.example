# Works as-is for a local trial: `cp .env.example .env && docker compose up`.
# Open http://app.localtest.me and read the sign-in code at http://localhost:8025.
#
# For a server, change every value marked "production" below. Each *_ADDRESS
# needs a DNS record that points at the server. Caddy serves plain HTTP on
# port 80, so put your own TLS-terminating proxy in front of it and use its
# https:// addresses in the two URLs below.

# Local trial only: allows the http:// URLs below, turns off the API's
# production safeguards (including auth rate limiting) and logs sign-in codes.
# Production: delete this line and use https:// URLs.
NODE_ENV=development

# The first user, who signs in with a code sent to this address.
EMAIL=admin@example.com
# Production: generate with `openssl rand -base64 48`.
BETTER_AUTH_SECRET=medialit-local-better-auth-secret-32b-min

# API, dashboard and MinIO S3 API hostnames, without a scheme.
# localtest.me always resolves to 127.0.0.1, so browsers reach the local stack.
# Inside the stack these names point at the proxy. Do not use localhost or
# *.localhost: there they mean the container itself, and Bun never looks them
# up in DNS.
# Production: for example medialit.example.com, app.medialit.example.com and
# s3.medialit.example.com, with the two URLs below set to match.
SITE_ADDRESS=api.localtest.me
WEB_SITE_ADDRESS=app.localtest.me
S3_SITE_ADDRESS=s3.localtest.me
PUBLIC_API_URL=http://api.localtest.me
WEB_ORIGIN=http://app.localtest.me

# Production: choose your own MinIO credentials.
MINIO_ROOT_USER=medialit
MINIO_ROOT_PASSWORD=medialit-secret

# Prefix for object keys inside the buckets.
PATH_PREFIX=medialit
TEMP_FILE_DIR_FOR_UPLOADS=/tmp/medialit

# Sign-in emails go to the bundled Mailpit. Production: use your SMTP server,
# for example smtp.example.com on port 587. EMAIL_USER and EMAIL_PASS are
# optional.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MediaLit <medialit@localhost.test>

# Set to true because the API runs behind the Caddy proxy.
ENABLE_TRUST_PROXY=true
