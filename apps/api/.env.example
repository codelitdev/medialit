# --- Better Auth / OAuth provider ---
# Signing key for Better Auth sessions and OAuth tokens. MUST be at least 32 bytes.
# Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public API origin used as the Better Auth issuer (no trailing slash).
API_PUBLIC_URL=http://localhost:8000
# Set in production when the web and API use sibling subdomains (for example,
# medialit.example.com). It lets the API-owned Better Auth session work on both.
AUTH_COOKIE_DOMAIN=

# Shared secret used only between the web server and the API's private routes.
# Generate with: openssl rand -hex 32
WEB_INTERNAL_API_SECRET=

# PostgreSQL connection used by the API.
DB_CONNECTION_STRING=postgresql://medialit:medialit@localhost:5432/medialit

# Writable local staging directory used while TUS uploads are assembled.
TEMP_FILE_DIR_FOR_UPLOADS=/tmp/medialit

# Access token lifetime in seconds. Keep short; refresh tokens are used to
# continue sessions and are revoked on logout.
TOKEN_TTL_SECONDS=900
