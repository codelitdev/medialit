# Local stack from docker-compose.local.yml. These values are for development only.
DATABASE_URL=postgresql://medialit:medialit@127.0.0.1:5433/medialit
PORT=8000
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth, besides WEB_ORIGIN.
# AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=medialit-local-better-auth-secret-32b-min
EMAIL=admin@example.com
TEMP_FILE_DIR_FOR_UPLOADS=/tmp/medialit

# MinIO. The S3 clients use path-style requests against CLOUD_ENDPOINT.
# CDN_ENDPOINT includes the public bucket because public file URLs are that
# origin plus the object key.
CLOUD_KEY=medialit
CLOUD_SECRET=medialit-secret
CLOUD_BUCKET_NAME=medialit
CLOUD_PUBLIC_BUCKET_NAME=medialit-public
CLOUD_REGION=us-east-1
CLOUD_ENDPOINT=http://127.0.0.1:9000
CLOUD_ENDPOINT_PUBLIC=http://127.0.0.1:9000
CDN_ENDPOINT=http://127.0.0.1:9000/medialit-public

POSTHOG_API_KEY=
POSTHOG_HOST=

# oss unlocks every limit and disables checkout. cloud is Basic until Pro is paid.
# MEDIALIT_DEPLOYMENT_MODE=oss
# Cloud checkout. Pro is $10/month (1000 minor units) or $100/year
# (10000 minor units). The BILLING_* values and the chosen provider's
# credentials are required together. Leave them empty to keep checkout off.
# MEDIALIT_DEPLOYMENT_MODE=cloud
# BILLING_PROVIDER=lemonsqueezy          # lemonsqueezy or dodo
# BILLING_CATALOG_REVISION=1             # raise it when prices, product IDs or the provider change
# BILLING_CURRENCY=USD
# BILLING_PRO_MONTH_AMOUNT_MINOR=1000
# BILLING_PRO_YEAR_AMOUNT_MINOR=10000
# BILLING_PRO_MONTH_PRODUCT_ID=          # Lemon Squeezy variant ID, or Dodo product ID
# BILLING_PRO_YEAR_PRODUCT_ID=
# BILLING_DATA_ENCRYPTION_KEY=           # base64 of 32 bytes
# Previous encryption keys, comma-separated, while rotating the key above.
# BILLING_DATA_ENCRYPTION_KEY_PREVIOUS=
# Billing changes need a session that signed in within this many seconds.
# BILLING_RECENT_AUTH_MAX_AGE_SECONDS=900
#
# New checkout goes to BILLING_PROVIDER. Every provider whose credentials are
# set below stays connected, so its existing subscribers can still renew,
# cancel, and open the portal. After switching BILLING_PROVIDER, keep the old
# provider's credentials and webhook until its last subscription has ended.
#
# Lemon Squeezy. The webhook URL is <PUBLIC_API_URL>/webhooks/billing/lemonsqueezy.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS=  # optional, while rotating
#
# Dodo Payments. The webhook URL is <PUBLIC_API_URL>/webhooks/billing/dodo.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_WEBHOOK_KEY_CURRENT=
# DODO_BRAND_ID=                         # optional; ignores other brands' webhooks

# Mailpit. Leave EMAIL_USER empty; Mailpit accepts mail without SMTP auth.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=medialit@localhost.test
