# Local stack from docker-compose.local.yml. These values are for development only.
DATABASE_URL=postgresql://medialit:medialit@127.0.0.1:5433/medialit
PORT=8000
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth, besides WEB_ORIGIN.
# AUTH_TRUSTED_ORIGINS=
# Shared parent domain for the session cookie when the API and dashboard are on
# different subdomains, for example `medialit.cloud`. Leave unset otherwise.
# AUTH_COOKIE_DOMAIN=
# Proxies to trust for the client address (Express's `trust proxy`): a hop
# count, `true`, `false`, or addresses and subnets such as
# `loopback, 10.0.0.0/8`. Unset: `ENABLE_TRUST_PROXY=true` trusts one hop,
# and nothing is trusted otherwise.
# TRUST_PROXY=
# ENABLE_TRUST_PROXY=
# Cloudflare Turnstile on the hosted login page. Set both keys or neither.
# The widget's hostname in Cloudflare must be PUBLIC_API_URL's host.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
BETTER_AUTH_SECRET=medialit-local-better-auth-secret-32b-min
EMAIL=admin@example.com
# Optional. An API key the API creates for EMAIL's default app at startup, so
# another service can use MediaLit without anyone opening the dashboard. At
# least 43 characters from [A-Za-z0-9_-]. Generate with:
#   echo ml_live_$(openssl rand -hex 32)
# MEDIALIT_BOOTSTRAP_API_KEY=
# Working folder for thumbnails and WebP conversion. Uploads themselves stream
# straight to the bucket.
TEMP_FILE_DIR_FOR_UPLOADS=/tmp/medialit
# Uploads go to the bucket in parts of this size (at least 5 MiB), with this
# many parts of one upload in flight at a time.
# UPLOAD_PART_SIZE_BYTES=8388608
# UPLOAD_PART_CONCURRENCY=2
# API-key and OAuth REST requests allowed per client address per minute.
# API_RATE_LIMIT_PER_MINUTE=120
# MCP requests allowed per client address per minute.
# MCP_RATE_LIMIT_PER_MINUTE=60
# Regular (form-data) uploads one API process streams at once. Each holds its
# parts in memory; past this the API answers 503 and clients retry.
# MAX_CONCURRENT_FORM_UPLOADS=16
# A connection with no data for this long is closed. Requests have no overall
# time limit, so big uploads on slow links can finish.
# REQUEST_IDLE_TIMEOUT_MS=120000
# An unfinished upload with no activity for this long (for example after a
# server crash) is cleaned up and its reserved storage freed. Resumable
# uploads stay resumable until their tus upload expires.
# UPLOAD_STALE_MINUTES=30

# WebP conversion runs when an app with WebP on seals an image. Each limit
# keeps the original image when hit, and the seal still succeeds. Pixels are
# read from the image header, without decoding it. cwebp runs under
# `prlimit --as` (util-linux); without prlimit it runs without a memory limit.
# WEBP_MAX_INPUT_BYTES=26214400
# WEBP_MAX_PIXELS=50000000
# WEBP_MAX_MEMORY_MB=1024
# WEBP_TIMEOUT_MS=30000
# Conversions at once per API process, and how long a seal waits for a slot
# before it seals without converting.
# WEBP_CONCURRENCY=2
# WEBP_QUEUE_WAIT_MS=10000
# A seal claims the media while it converts and copies, and renews the claim
# as it goes. A claim not renewed for SEAL_CLAIM_MS is taken over. A second
# seal of the same media waits up to SEAL_WAIT_MS, then answers 503.
# SEAL_CLAIM_MS=120000
# SEAL_WAIT_MS=15000

# MinIO. The S3 clients use path-style requests against CLOUD_ENDPOINT.
# CDN_ENDPOINT includes the public bucket because public file URLs are that
# origin plus the object key.
CLOUD_KEY=medialit
CLOUD_SECRET=medialit-secret
CLOUD_BUCKET_NAME=medialit
CLOUD_PUBLIC_BUCKET_NAME=medialit-public
CLOUD_REGION=us-east-1
CLOUD_ENDPOINT=http://127.0.0.1:9000
CLOUD_ENDPOINT_PUBLIC=http://127.0.0.1:9000
CDN_ENDPOINT=http://127.0.0.1:9000/medialit-public

# Optional. With a key, errors are captured and every log line is also sent
# to PostHog's logs, from the API and the worker.
POSTHOG_API_KEY=
POSTHOG_HOST=

# oss unlocks every limit and disables checkout. cloud is Basic until Pro is paid.
# MEDIALIT_DEPLOYMENT_MODE=oss
# Cloud checkout. Pro is $10/month (1000 minor units) or $100/year
# (10000 minor units). The BILLING_* values and the chosen provider's
# credentials are required together. Leave them empty to keep checkout off.
# MEDIALIT_DEPLOYMENT_MODE=cloud
# BILLING_PROVIDER=lemonsqueezy          # lemonsqueezy or dodo
# BILLING_CATALOG_REVISION=1             # raise it when prices, product IDs or the provider change
# BILLING_CURRENCY=USD
# BILLING_PRO_MONTH_AMOUNT_MINOR=1000
# BILLING_PRO_YEAR_AMOUNT_MINOR=10000
# BILLING_PRO_MONTH_PRODUCT_ID=          # Lemon Squeezy variant ID, or Dodo product ID
# BILLING_PRO_YEAR_PRODUCT_ID=
# BILLING_DATA_ENCRYPTION_KEY=           # base64 of 32 bytes
# Previous encryption keys, comma-separated, while rotating the key above.
# BILLING_DATA_ENCRYPTION_KEY_PREVIOUS=
# Billing changes need a session that signed in within this many seconds.
# BILLING_RECENT_AUTH_MAX_AGE_SECONDS=900
#
# New checkout goes to BILLING_PROVIDER. Every provider whose credentials are
# set below stays connected, so its existing subscribers can still renew,
# cancel, and open the portal. After switching BILLING_PROVIDER, keep the old
# provider's credentials and webhook until its last subscription has ended.
#
# Lemon Squeezy. The webhook URL is <PUBLIC_API_URL>/webhooks/billing/lemonsqueezy.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS=  # optional, while rotating
#
# Dodo Payments. The webhook URL is <PUBLIC_API_URL>/webhooks/billing/dodo.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_WEBHOOK_KEY_CURRENT=
# DODO_BRAND_ID=                         # optional; ignores other brands' webhooks

# Mailpit. Leave EMAIL_USER empty; Mailpit accepts mail without SMTP auth.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=medialit@localhost.test

# The worker (bun run dev:worker) runs background jobs. It serves /health and
# /ready on WORKER_PORT. Jobs of the cpu class (media processing) default to
# one per CPU core, io jobs (cleanup, webhooks) to 16. WORKER_CLASSES limits a
# worker to some classes, for example `io`. On shutdown, running jobs get
# WORKER_SHUTDOWN_GRACE_MS to finish before they go back to the queue.
# WORKER_PORT=8001
# WORKER_CONCURRENCY_CPU=
# WORKER_CONCURRENCY_IO=16
# WORKER_CLASSES=cpu,io
# WORKER_SHUTDOWN_GRACE_MS=8000

# Video processing minutes a month (pipelines-phase-1.md, D8). Self-hosted
# installs have no limit; these apply on the hosted free and paid plans.
# PROCESSING_MINUTES_FREE=5
# PROCESSING_MINUTES_PAID=300

# Comma-separated addresses that get an email when the job queue needs
# attention (no worker running, jobs waiting or failing). Sent through the
# EMAIL_* settings above, in production only. Empty sends no email; the alert
# is still logged.
# OPERATOR_ALERT_EMAIL=ops@example.com

# Webhook URLs that resolve to loopback, private, link-local (cloud metadata),
# CGNAT, multicast or reserved addresses are refused, and production accepts
# https only. Set true to allow them when your receivers run on your own
# network and everyone who can add an endpoint is trusted. The worker warns at
# startup while it is set. Never set it on a shared or hosted install.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
