-muted);border-bottom:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code:first-child .mlc-code-head{background:var(--mlc-tint-strong)}\n.mlc-wrap .mlc-pre{flex:1;margin:0;padding:16px;overflow-x:auto;font-size:.8rem;line-height:1.65;color:var(--mlc-fg);background:transparent;border:0;border-radius:0;white-space:pre;tab-size:2}\n.mlc-wrap .mlc-pre code{font:inherit;background:none;padding:0;color:inherit}\n.mlc-wrap .mlc-code-note{margin:0;padding:10px 16px;font-size:.8rem;color:var(--mlc-mfg);border-top:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code-note a,.mlc-wrap .mlc-note a,.mlc-wrap .mlc-table a,.mlc-wrap .mlc-foot a,.mlc-wrap .mlc-also a{color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-faq{display:grid;gap:10px}\n.mlc-wrap .mlc-faq-item{background:var(--mlc-card);border:1px solid var(--mlc-border);border-radius:16px;padding:0}\n.mlc-wrap .mlc-faq-item summary{cursor:pointer;list-style:none;padding:14px 44px 14px 18px;font-weight:600;position:relative;color:var(--mlc-fg);border-radius:16px}\n.mlc-wrap .mlc-faq-item summary::-webkit-details-marker{display:none}\n.mlc-wrap .mlc-faq-item summary::after{content:\"\";position:absolute;right:20px;top:50%;width:8px;height:8px;border-right:2px solid var(--mlc-accent);border-bottom:2px solid var(--mlc-accent);transform:translateY(-70%) rotate(45deg);transition:transform .15s}\n.mlc-wrap .mlc-faq-item[open] summary::after{transform:translateY(-30%) rotate(225deg)}\n.mlc-wrap .mlc-faq-item p{margin:0;padding:0 18px 16px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-foot{margin:32px 0 0;font-size:.82rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-cta{margin-top:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 28px;background:var(--mlc-tint);border:1px solid var(--mlc-accent);border-radius:16px}\n.mlc-wrap .mlc-cta-title{margin:0 0 4px;font-size:1.25rem;font-weight:700;color:var(--mlc-fg)}\n.mlc-wrap .mlc-cta-text{margin:0;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-btn{flex:none;display:inline-block;padding:11px 22px;border-radius:10px;background:var(--mlc-accent);color:#1a1228;font-weight:600;text-decoration:none;border:1px solid var(--mlc-accent);transition:filter .15s}\n.mlc-wrap .mlc-btn:hover{filter:brightness(1.08);color:#1a1228}\n.mlc-wrap .mlc-btns{flex:none;display:flex;flex-wrap:wrap;gap:10px}\n.mlc-wrap .mlc-btn-2{background:transparent;color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-btn-2:hover{background:var(--mlc-card);color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-note{margin:10px 0 0;font-size:.8rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets{margin:0;padding-left:20px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets li{margin:0 0 10px}\n.mlc-wrap .mlc-bullets strong{color:var(--mlc-fg)}\n.mlc-wrap .mlc-stay,.mlc-wrap .mlc-switch{margin-top:36px}\n.mlc-wrap .mlc-stay{padding:22px;border:1px solid var(--mlc-border);border-radius:14px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:18px 0 4px}\n.mlc-wrap .mlc-move-grid>div{padding:18px;border:1px solid var(--mlc-border);border-radius:12px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-title{margin:0 0 10px;font-size:1rem}\n.mlc-wrap .mlc-also{margin-top:22px;font-size:.95rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-panel-hero{margin-top:8px}\n.mlc-wrap a:focus-visible,.mlc-wrap summary:focus-visible,.mlc-wrap .mlc-scroll:focus-visible,.mlc-wrap .mlc-pre:focus-visible,.mlc-wrap .mlc-btn:focus-visible{outline:2px solid var(--mlc-accent);outline-offset:2px}\n@container (max-width:720px){.mlc-wrap .mlc-codes{grid-template-columns:1fr}.mlc-wrap .mlc-cta{flex-direction:column;align-items:flex-start;padding:20px}}\n@container (max-width:640px){.mlc-wrap .mlc-move-grid{grid-template-columns:1fr;gap:14px}.mlc-wrap .mlc-stay{padding:18px}}\n@container (max-width:560px){.mlc-wrap .mlc-table{min-width:0;font-size:.9rem}.mlc-wrap .mlc-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.mlc-wrap .mlc-table,.mlc-wrap .mlc-table tbody,.mlc-wrap .mlc-table tr,.mlc-wrap .mlc-table th,.mlc-wrap .mlc-table td{display:block;width:auto}.mlc-wrap .mlc-table tbody tr{border-bottom:1px solid var(--mlc-border);padding:12px 14px}.mlc-wrap .mlc-table tbody tr:last-child{border-bottom:0}.mlc-wrap .mlc-table tbody th{width:auto;padding:0 0 8px;border:0;font-weight:600;color:var(--mlc-fg)}.mlc-wrap .mlc-table tbody td{width:auto;padding:8px 10px;border:0;border-radius:6px}.mlc-wrap .mlc-table tbody td+td{margin-top:6px;background:var(--mlc-muted)}.mlc-wrap .mlc-table tbody td::before{content:attr(data-mlc-label);display:block;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mlc-mfg);margin-bottom:2px}.mlc-wrap .mlc-pre{font-size:.74rem;padding:14px}}\n</style>\n<div class=\"mlc-head\"><p class=\"mlc-kicker\">MediaLit vs Cloudinary</p><h1 class=\"mlc-h2\">Store and serve files without paying for a media platform.</h1><p class=\"mlc-lead\">Cloudinary is one of the most capable media platforms around. If you need on-the-fly image transforms, video transcoding or a DAM, it does far more than MediaLit. If you mostly need user uploads, documents and agent-generated files with a flat bill, MediaLit is the smaller tool for that job.</p><div class=\"mlc-eyebrow-note\">Pricing checked 6 November 2026. Includes where Cloudinary is stronger.</div></div>\n<section class=\"mlc-panel mlc-panel-hero\" id=\"mlc-panel-cloudinary\"><h2 class=\"mlc-h3\">Side by side</h2><p class=\"mlc-intro\">Cloudinary prices by shared credits across storage, bandwidth and transformations. MediaLit prices by storage and max file size. Both offer MCP access. Only MediaLit is open source and self-hostable.</p><a class=\"mlc-article\" href=\"/blog/medialit-vs-cloudinary\">Read the longer write-up <span aria-hidden=\"true\">&rarr;</span></a>\n<div class=\"mlc-table-card\"><div class=\"mlc-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"MediaLit and Cloudinary comparison table\"><table class=\"mlc-table\"><caption class=\"mlc-sr\">MediaLit compared with Cloudinary</caption><thead><tr><th scope=\"col\">Feature</th><th scope=\"col\" class=\"mlc-col-ml\">MediaLit</th><th scope=\"col\">Cloudinary</th></tr></thead><tbody>\n<tr><th scope=\"row\">Signup required</th><td data-mlc-label=\"MediaLit\">Yes, free account</td><td data-mlc-label=\"Cloudinary\">Yes</td></tr><tr><th scope=\"row\">Free plan</th><td data-mlc-label=\"MediaLit\">Basic: 1 GB storage, 50 MB max file, unlimited uploads and downloads</td><td data-mlc-label=\"Cloudinary\">25 credits/mo (1 credit = 1 GB storage, 1 GB bandwidth or 1,000 transformations)</td></tr><tr><th scope=\"row\">Paid plan price</th><td data-mlc-label=\"MediaLit\">Pro: $10/mo or $100/yr for 100 GB storage and a 2 GB max file (<a href=\"/#pricing\">see current pricing</a>)</td><td data-mlc-label=\"Cloudinary\">Plus $99/mo ($89/mo billed yearly) for 225 credits. Advanced $249/mo ($224 yearly) for 600 credits</td></tr><tr><th scope=\"row\">Max file size</th><td data-mlc-label=\"MediaLit\">50 MB (Basic), 2 GB (Pro)</td><td data-mlc-label=\"Cloudinary\">Free: 10 MB images / raw, 100 MB video. Plus: 20 MB / 2 GB. Advanced: 40 MB / 4 GB</td></tr><tr><th scope=\"row\">Setup time (est.)</th><td data-mlc-label=\"MediaLit\">~5 min</td><td data-mlc-label=\"Cloudinary\">~5 min</td></tr><tr><th scope=\"row\">Lines of code (upload a file, get a URL)</th><td data-mlc-label=\"MediaLit\">7 lines</td><td data-mlc-label=\"Cloudinary\">4 lines</td></tr><tr><th scope=\"row\">SDK needed</th><td data-mlc-label=\"MediaLit\">No. REST API, or the optional <code>medialit</code> Node SDK</td><td data-mlc-label=\"Cloudinary\">No. REST API, SDKs available</td></tr><tr><th scope=\"row\">Presigned / browser uploads</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. Short-lived upload signatures; browser uploads are resumable (tus)</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. Upload widget and signed uploads</span></span></td></tr><tr><th scope=\"row\">Signed private URLs</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes on every plan. Private files get expiring signed URLs</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. Private and authenticated delivery. Token/cookie auth on Advanced and up</span></span></td></tr><tr><th scope=\"row\">CDN included</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. Delivery through a CDN</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. CDN delivery on every plan</span></span></td></tr><tr><th scope=\"row\">Egress / bandwidth</th><td data-mlc-label=\"MediaLit\">Unlimited uploads and downloads listed on the pricing section. No separate egress rate published</td><td data-mlc-label=\"Cloudinary\">Counted in credits (1 credit = 1 GB bandwidth)</td></tr><tr><th scope=\"row\">Image / video processing</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-p\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 8h8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><span><span class=\"mlc-sr\">Partly: </span>Thumbnails on upload, optional WebP conversion. No on-the-fly URL transforms</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Extensive on-the-fly image and video transforms, transcoding and adaptive streaming</span></span></td></tr><tr><th scope=\"row\">AI-agent access</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Hosted MCP at <code>https://api.medialit.cloud/mcp</code> with OAuth, plus the <code>medialit</code> CLI</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>MCP server access on every plan, plus a CLI</span></span></td></tr><tr><th scope=\"row\">Open source / self-host</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes. AGPL server, MIT clients. Self-host on S3, R2, MinIO or any S3-compatible storage</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-n\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4.5 4.5l7 7M11.5 4.5l-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><span><span class=\"mlc-sr\">No: </span>No self-hosted version</span></span></td></tr><tr><th scope=\"row\">File versioning</th><td data-mlc-label=\"MediaLit\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-n\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4.5 4.5l7 7M11.5 4.5l-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><span><span class=\"mlc-sr\">No: </span>No</span></span></td><td data-mlc-label=\"Cloudinary\"><span class=\"mlc-cell\"><svg class=\"mlc-ic mlc-ic-y\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3.5 8.5l3 3 6-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span><span class=\"mlc-sr\">Yes: </span>Yes via Backup (off by default; backups count toward storage unless you use your own bucket on paid plans)</span></span></td></tr>\n</tbody></table></div></div>\n<p class=\"mlc-note\">Sources: <a href=\"https://cloudinary.com/pricing\">Cloudinary pricing</a>, <a href=\"https://cloudinary.com/pricing/compare-plans\">compare plans</a>, <a href=\"https://cloudinary.com/documentation/pricing\">credits docs</a>, <a href=\"https://medialit.cloud/#pricing\">MediaLit pricing</a>. USD, checked 6 November 2026.</p>\n<h4 class=\"mlc-h4\">Upload a file and get a URL</h4>\n<div class=\"mlc-codes\">\n<figure class=\"mlc-code\"><figcaption class=\"mlc-code-head\"><span>MediaLit</span><span class=\"mlc-chip\">Node.js</span></figcaption><pre class=\"mlc-pre\" tabindex=\"0\"><code>import { MediaLit } from &quot;medialit&quot;;\n\nconst medialit = new MediaLit(); // reads MEDIALIT_API_KEY\nconst { mediaId } = await medialit.upload(&quot;./photo.jpg&quot;, {\n  access: &quot;public&quot;,\n});\nconst media = await medialit.seal(mediaId); // keep it\nconsole.log(media.file);</code></pre><p class=\"mlc-code-note\">Uploads stay temporary until <code>seal()</code>. Unsealed files are deleted after 24 hours.</p></figure>\n<figure class=\"mlc-code\"><figcaption class=\"mlc-code-head\"><span>Cloudinary</span><span class=\"mlc-chip\">Node.js</span></figcaption><pre class=\"mlc-pre\" tabindex=\"0\"><code>import { v2 as cloudinary } from &quot;cloudinary&quot;;\n\n// reads CLOUDINARY_URL\nconst result =\n  await cloudinary.uploader.upload(&quot;./photo.jpg&quot;);\nconsole.log(result.secure_url);</code></pre><p class=\"mlc-code-note\">Returns a CDN URL immediately. Transformations are applied later via URL parameters.</p></figure>\n</div>\n<h4 class=\"mlc-h4\">Questions</h4>\n<div class=\"mlc-faq\">\n<details class=\"mlc-faq-item\"><summary>Is MediaLit a full Cloudinary replacement?</summary><p>Only if you use Cloudinary mainly for storage and delivery. For heavy image or video transformation, Cloudinary does more.</p></details>\n<details class=\"mlc-faq-item\"><summary>How does Cloudinary pricing work?</summary><p>One credit equals 1 GB storage, 1 GB bandwidth or 1,000 transformations. Free gets 25 credits a month. Plus gets 225. MediaLit does not use credits: Basic is 1 GB free; Pro is $10/mo or $100/yr for 100 GB storage and a 2 GB max file (<a href=\"/#pricing\">see current pricing</a>).</p></details>\n<details class=\"mlc-faq-item\"><summary>Does MediaLit keep old versions of a file?</summary><p>No. MediaLit has no file versioning. Cloudinary offers Backup-based revision history.</p></details>\n<details class=\"mlc-faq-item\"><summary>Can AI agents use both?</summary><p>Yes. MediaLit has a hosted MCP server with OAuth plus a CLI. Cloudinary lists MCP server access on every plan, plus a CLI.</p></details>\n</div>\n<section class=\"mlc-panel mlc-stay\" id=\"mlc-stick-with-cloudinary\"><h2 class=\"mlc-h3\">Stick with Cloudinary if…</h2><p class=\"mlc-intro\">We'd rather you pick the right tool than migrate twice. Cloudinary wins in clear cases:</p>\n<ul class=\"mlc-bullets\">\n<li><strong>Your product depends on responsive images or on-the-fly crops.</strong> Cloudinary transforms from URL parameters. MediaLit only makes a thumbnail at upload and can optionally convert to WebP.</li>\n<li><strong>You serve a lot of video.</strong> Cloudinary has transcoding and adaptive streaming. MediaLit stores video and makes a thumbnail.</li>\n<li><strong>You need a DAM or version history.</strong> Cloudinary has asset management, auto-tagging and Backup. MediaLit has no file versioning.</li>\n<li><strong>Your team already lives in Cloudinary.</strong> Switching storage is easy; rewriting a transform pipeline is not.</li>\n</ul></section>\n<section class=\"mlc-panel mlc-switch\" id=\"mlc-switch-to-medialit-cloudinary\"><h2 class=\"mlc-h3\">What moves with you, and what stays</h2><p class=\"mlc-intro\">Export originals from Cloudinary, re-upload them, and store the returned <code>mediaId</code> in place of the Cloudinary public ID.</p>\n<div class=\"mlc-move-grid\"><div><h3 class=\"mlc-move-title\">Moves with you</h3><ul class=\"mlc-bullets\"><li>Original files (re-upload via CLI or SDK)</li><li>Public and private access patterns</li><li>Your app's upload flow, via <code>@medialit/react</code> or the REST API</li><li>The option to self-host later on the same API</li></ul></div><div><h3 class=\"mlc-move-title\">Stays on Cloudinary</h3><ul class=\"mlc-bullets\"><li>URL-based transformations and derived assets</li><li>Video transcoding and adaptive streaming</li><li>DAM features, auto-tagging and Backup history</li><li>Existing transformation URLs in production</li></ul></div></div>\n<p class=\"mlc-note\">If you rely on transformation URLs, plan a replacement first. MediaLit gives you a thumbnail and optional WebP conversion, not URL-based transforms. <a href=\"https://medialit.cloud/docs/introduction\">MediaLit docs</a>.</p></section>\n<div class=\"mlc-cta\"><div><p class=\"mlc-cta-title\">Try MediaLit for storage</p><p class=\"mlc-cta-text\">Start on the free Basic plan. Move to Pro for $10/mo or $100/yr when you need 100 GB and 2 GB uploads. <a href=\"/#pricing\">See current pricing</a>.</p></div><div class=\"mlc-btns\"><a class=\"mlc-btn\" href=\"https://app.medialit.cloud/login\">Start free</a><a class=\"mlc-btn mlc-btn-2\" href=\"/#pricing\">See pricing</a></div></div>\n</section>\n<p class=\"mlc-also\">Also comparing? <a href=\"/compare\">All MediaLit comparisons</a> · <a href=\"/compare-uploadthing\">MediaLit vs UploadThing</a> · <a href=\"/blog/medialit-vs-cloudinary\">Longer write-up</a></p>\n<p class=\"mlc-foot\">Prices and limits checked 6 November 2026 from <a href=\"https://cloudinary.com/pricing\">Cloudinary</a> and <a href=\"https://medialit.cloud/#pricing\">MediaLit</a>. Setup time is an estimate for a developer new to each service. Lines of code are counted from the samples above (non-blank, non-comment). Spotted something out of date? <a href=\"https://github.com/codelitdev/medialit/issues\">Open an issue</a>.</p>\n</div>"
      }
    }
  ]
}
