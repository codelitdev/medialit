        "content": "<div class=\"mlc-wrap\" id=\"mlc-compare-cloudinary\"><style>\n.mlc-wrap{--mlc-fg:var(--foreground,#261d16);--mlc-mfg:var(--muted-foreground,#6a6258);--mlc-card:var(--card,#fefdfb);--mlc-border:var(--border,#e2ddd5);--mlc-bg:var(--background,#f9f6f2);--mlc-muted:var(--muted,#eeebe5);--mlc-accent:#9b78d6;--mlc-accent-text:#7d5bb8;--mlc-accent-text:color-mix(in srgb,#9b78d6 68%,var(--mlc-fg));--mlc-tint:rgba(155,120,214,.14);--mlc-tint-strong:rgba(155,120,214,.24);container-type:inline-size;color:var(--mlc-fg);font:inherit;line-height:1.6;max-width:1080px;margin:0 auto;text-align:left}\n.mlc-wrap *,.mlc-wrap *::before,.mlc-wrap *::after{box-sizing:border-box}\n.mlc-wrap .mlc-head{max-width:760px;margin:0 0 28px}\n.mlc-wrap .mlc-kicker{margin:0 0 8px;font-size:.8rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-h2{margin:0 0 12px;font-size:clamp(1.75rem,4.5vw,2.5rem);line-height:1.15;font-weight:700;letter-spacing:-.01em;color:var(--mlc-fg)}\n.mlc-wrap .mlc-lead{margin:0;font-size:1.05rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-eyebrow-note{margin-top:14px;font-size:.92rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-h3{margin:0 0 10px;font-size:1.5rem;line-height:1.25;font-weight:700;color:var(--mlc-fg)}\n.mlc-wrap .mlc-h4{margin:36px 0 14px;font-size:1.1rem;font-weight:600;color:var(--mlc-fg)}\n.mlc-wrap .mlc-intro{margin:0 0 12px;max-width:780px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-article{display:inline-block;margin:0 0 16px;color:var(--mlc-accent-text);font-weight:600;text-decoration:none}\n.mlc-wrap .mlc-article:hover{text-decoration:underline}\n.mlc-wrap .mlc-table-card{margin-top:20px;background:var(--mlc-card);border:1px solid var(--mlc-border);border-radius:16px;overflow:hidden}\n.mlc-wrap .mlc-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}\n.mlc-wrap .mlc-table{width:100%;min-width:620px;border-collapse:collapse;font-size:.92rem;margin:0;background:transparent}\n.mlc-wrap .ml