ted);border-bottom:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code:first-child .mlc-code-head{background:var(--mlc-tint-strong)}\n.mlc-wrap .mlc-pre{flex:1;margin:0;padding:16px;overflow-x:auto;font-size:.8rem;line-height:1.65;color:var(--mlc-fg);background:transparent;border:0;border-radius:0;white-space:pre;tab-size:2}\n.mlc-wrap .mlc-pre code{font:inherit;background:none;padding:0;color:inherit}\n.mlc-wrap .mlc-code-note{margin:0;padding:10px 16px;font-size:.8rem;color:var(--mlc-mfg);border-top:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code-note a,.mlc-wrap .mlc-note a,.mlc-wrap .mlc-table a,.mlc-wrap .mlc-foot a,.mlc-wrap .mlc-also a{color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-faq{display:grid;gap:10px}\n.mlc-wrap .mlc-faq-item{background:var(--mlc-card);border:1px solid var(--mlc-border);border-radius:16px;padding:0}\n.mlc-wrap .mlc-faq-item summary{cursor:pointer;list-style:none;padding:14px 44px 14px 18px;font-weight:600;position:relative;color:var(--mlc-fg);border-radius:16px}\n.mlc-wrap .mlc-faq-item summary::-webkit-details-marker{display:none}\n.mlc-wrap .mlc-faq-item summary::after{content:\"\";position:absolute;right:20px;top:50%;width:8px;height:8px;border-right:2px solid var(--mlc-accent);border-bottom:2px solid var(--mlc-accent);transform:translateY(-70%) rotate(45deg);transition:transform .15s}\n.mlc-wrap .mlc-faq-item[open] summary::after{transform:translateY(-30%) rotate(225deg)}\n.mlc-wrap .mlc-faq-item p{margin:0;padding:0 18px 16px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-foot{margin:32px 0 0;font-size:.82rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-cta{margin-top:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 28px;background:var(--mlc-tint);border:1px solid var(--mlc-accent);border-radius:16px}\n.mlc-wrap .mlc-cta-title{margin:0 0 4px;font-size:1.25rem;font-weight:700;color:var(--mlc-fg)}\n.mlc-wrap .mlc-cta-text{margin:0;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-btn{flex:none;display:inline-block;padding:11px 22px;border-radius:10px;background:var(--mlc-accent);color:#1a1228;font-weight:600;text-decoration:none;border:1px solid var(--mlc-accent);transition:filter .15s}\n.mlc-wrap .mlc-btn:hover{filter:brightness(1.08);color:#1a1228}\n.mlc-wrap .mlc-btns{flex:none;display:flex;flex-wrap:wrap;gap:10px}\n.mlc-wrap .mlc-btn-2{background:transparent;color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-btn-2:hover{background:var(--mlc-card);color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-note{margin:10px 0 0;font-size:.8rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets{margin:0;padding-left:20px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets li{margin:0 0 10px}\n.mlc-wrap .mlc-bullets strong{color:var(--mlc-fg)}\n.mlc-wrap .mlc-stay,.mlc-wrap .mlc-switch{margin-top:36px}\n.mlc-wrap .mlc-stay{padding:22px;border:1px solid var(--mlc-border);border-radius:14px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:18px 0 4px}\n.mlc-wrap .mlc-move-grid>div{padding:18px;border:1px solid var(--mlc-border);border-radius:12px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-title{margin:0 0 10px;font-size:1rem}\n.mlc-wrap .mlc-also{margin-top:22px;font-size:.95rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-panel-hero{margin-top:8px}\n.mlc-wrap a:focus-visible,.mlc-wrap summary:focus-visible,.mlc-wrap .mlc-scroll:focus-visible,.mlc-wrap .mlc-pre:focus-visible,.mlc-wrap .mlc-btn:focus-visible{outline:2px solid var(--mlc-accent);outline-offset:2px}\n@container (max-width:720px){.mlc-wrap .mlc-codes{grid-template-columns:1fr}.mlc-wrap .mlc-cta{flex-direction:column;align-items:flex-start;padding:20px}}\n@container (max-width:640px){.mlc-wrap .mlc-move-grid{grid-template-columns:1fr;gap:14px}.mlc-wrap .mlc-stay{padding:18px}}\n@container (max-width:560px){.mlc-wrap .mlc-table{min-width:0;font-size:.9rem}.mlc-wrap .mlc-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.mlc-wrap .mlc-table,.mlc-wrap .mlc-table tbody,.mlc-wrap .mlc-table tr,.mlc-wrap .mlc-table th,.mlc-wrap .mlc-table td{display:block;width:auto}.mlc-wrap .mlc-table tbody tr{border-bottom:1px solid var(--mlc-border);padding:12px 14px}.mlc-wrap .mlc-table tbody tr:last-child{border-bottom:0}.mlc-wrap .mlc-table tbody th{width:auto;padding:0 0 8px;border:0;font-weight:600;color:var(--mlc-fg)}.mlc-wrap .mlc-table tbody td{width:auto;padding:8px 10px;border:0;border-radius:6px}.mlc-wrap .mlc-table tbody td+td{margin-top:6px;background:var(--mlc-muted)}.mlc-wrap .mlc-table tbody td::before{content:attr(data-mlc-label);display:block;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mlc-mfg);margin-bottom:2px}.mlc-wrap .mlc-pre{font-size:.74rem;padding:14px}}\n.mlc-wrap .mlc-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:18px 0 4px}\n.mlc-wrap .mlc-card{padding:18px;border:1px solid var(--mlc-border);border-radius:14px;background:var(--mlc-card)}\n.mlc-wrap .mlc-card .mlc-move-title{margin:0 0 6px;font-size:1rem;font-weight:600;color:var(--mlc-fg)}\n.mlc-wrap .mlc-card p{margin:0;font-size:.92rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-intro code,.mlc-wrap .mlc-card code,.mlc-wrap .mlc-bullets code{font-family:\"Spline Sans Mono\",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.85em;background:var(--mlc-muted);border-radius:6px;padding:1px 5px;color:var(--mlc-fg)}\n.mlc-wrap .mlc-intro a,.mlc-wrap .mlc-card a,.mlc-wrap .mlc-bullets a{color:var(--mlc-accent-text)}\n@container (max-width:860px){.mlc-wrap .mlc-cards{grid-template-columns:1fr 1fr}}\n@container (max-width:560px){.mlc-wrap .mlc-cards{grid-template-columns:1fr}}\n</style>\n<div class=\"mlc-head\"><p class=\"mlc-kicker\">For agents</p><h1 class=\"mlc-h2\">File storage for AI agents</h1><p class=\"mlc-lead\">Give Claude, ChatGPT, Cursor and coding agents a place to save the files they make and a link to share them. Connect over MCP with a browser sign-in, or use the CLI from a terminal or CI job.</p></div>\n<section class=\"mlc-panel mlc-panel-hero\">\n<h2 class=\"mlc-h3\">What you get</h2><p class=\"mlc-intro\">Agents make reports, charts, exports and screenshots. Without somewhere to put them, those files stay stuck in a chat or a sandbox. MediaLit gives an agent a place to save a file and a link to hand back to you.</p><div class=\"mlc-cards\"><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">A remote MCP server</h3><p>Add <code>https://api.medialit.cloud/mcp</code> to Claude, ChatGPT, Cursor or any MCP client. It uses Streamable HTTP, so there&#39;s nothing to install or run.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Sign in, no key to paste</h3><p>The client sends you to MediaLit&#39;s sign-in page with OAuth. You enter your email, approve the connection, and the client handles tokens. An API key header works too.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">A CLI for coding agents</h3><p>Claude Code, Codex and Cursor&#39;s agent can run <code>medialit upload</code>. It uploads in resumable chunks, prints the file&#39;s link, and reads <code>MEDIALIT_API_KEY</code> in CI.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Scratch files clean up</h3><p>Files an agent uploads over MCP stay temporary until it, or you, seals them. Unsealed files are deleted after 24 hours.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">A check before it can&#39;t be undone</h3><p>Sealing and deleting only run when the agent passes <code>confirm: true</code>, so it has to check with you first.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">One set of files</h3><p>What an agent saves shows up in your dashboard and in the API, so your app can serve the same file from the same URL.</p></div></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">Connect an agent</h2><p class=\"mlc-intro\">Connect over MCP for chat assistants, or give coding agents the CLI. Both sign in through your browser and work in the app you pick.</p><div class=\"mlc-codes\" style=\"grid-template-columns:1fr\"><figure class=\"mlc-code\"><figcaption class=\"mlc-code-head\"><span>Terminal</span><span class=\"mlc-chip\">MCP + CLI</span></figcaption><pre class=\"mlc-pre\" tabindex=\"0\"><code># Claude Code: add the remote MCP server, then run /mcp to sign in\nclaude mcp add --transport http medialit https://api.medialit.cloud/mcp\n\n# Any other MCP client: add this URL as a remote server and sign in\nhttps://api.medialit.cloud/mcp\n\n# Coding agents that run commands can use the CLI\nnpm install -g @medialit/cli\nmedialit login                                   # opens your browser\nmedialit upload report.pdf --group reports       # private by default, prints a link\nmedialit upload chart.png --public               # permanent public URL\nmedialit upload scratch.csv --temp               # deleted after 24 hours unless sealed\n\n# In CI, use an API key from the environment instead of logging in\n# MEDIALIT_API_KEY=...\nmedialit upload dist/build-report.html --group ci</code></pre><p class=\"mlc-code-note\">MCP uploads are private unless the agent asks for <code>public</code>. Private files are shared through links that expire.</p></figure></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">What an agent can do over MCP</h2><ul class=\"mlc-bullets\"><li><strong>Save files:</strong> <code>upload_media</code>, then <code>seal_media</code> to keep them.</li><li><strong>Find and share files:</strong> <code>list_media</code> filtered by group or access, and <code>get_media</code> for a file&#39;s details and link.</li><li><strong>Tidy up:</strong> <code>delete_media</code> removes a file and its thumbnail.</li><li><strong>Check usage:</strong> <code>get_total_storage</code> and <code>get_media_count</code>.</li><li><strong>Hand off a big upload:</strong> <code>create_upload_signature</code> lets a browser or script upload one file without an API key.</li></ul><div class=\"mlc-stay\"><h2 class=\"mlc-h3\">What it doesn&#39;t do</h2><ul class=\"mlc-bullets\"><li>MCP uploads are sent as base64 in a request capped at 2 MB, so <code>upload_media</code> handles files up to about 1.5 MB. Larger files go through the CLI or an upload signature.</li><li>Each connection works in one app. To use a different app, connect again and pick it.</li><li>It stores and shares files. It doesn&#39;t search inside them or run the agent for you.</li></ul></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">Questions</h2><div class=\"mlc-faq\"><details class=\"mlc-faq-item\"><summary>How do I give Claude or ChatGPT file storage?</summary><p>Add <code>https://api.medialit.cloud/mcp</code> as a remote MCP server in the client, then sign in when it asks. The <a href=\"/docs/mcp-server\">MCP server guide</a> has the steps for each client.</p></details><details class=\"mlc-faq-item\"><summary>Can coding agents like Claude Code or Codex use it?</summary><p>Yes. They can use the MCP server, or run the <a href=\"/docs/cli\">CLI</a>, which seals uploads right away unless you pass <code>--temp</code>.</p></details><details class=\"mlc-faq-item\"><summary>What does it cost?</summary><p>Basic is free with 1 GB of storage and files up to 50 MB. Pro is $10/mo or $100/yr for 100 GB and files up to 2 GB. Agent uploads count toward the same storage as everything else.</p></details></div>\n<div class=\"mlc-cta\"><div><p class=\"mlc-cta-title\">Connect your first agent</p><p class=\"mlc-cta-text\">Basic is free with 1 GB. Sign in, then add the MCP server to your client.</p></div><div class=\"mlc-btns\"><a class=\"mlc-btn\" href=\"https://app.medialit.cloud/login\">Start free</a><a class=\"mlc-btn mlc-btn-2\" href=\"/docs/mcp-server\">Read the MCP guide</a></div></div>\n<p class=\"mlc-also\">Also see: <a href=\"/file-uploads\">file uploads for your app</a> · <a href=\"/file-storage\">file storage for businesses</a> · <a href=\"/compare#vercel-blob\">MediaLit vs Vercel Blob</a> · <a href=\"/compare#s3\">MediaLit vs Amazon S3</a></p>\n</section>\n<p class=\"mlc-foot\">Plan limits are from <a href=\"https://medialit.cloud/#pricing\">medialit.cloud</a>. MediaLit is open source: the client packages are MIT and the server is AGPL. Spotted something out of date? <a href=\"https://github.com/codelitdev/medialit/issues\">Open an issue</a>.</p>\n</div>"
      }
    }
