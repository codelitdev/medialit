ed);border-bottom:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code:first-child .mlc-code-head{background:var(--mlc-tint-strong)}\n.mlc-wrap .mlc-pre{flex:1;margin:0;padding:16px;overflow-x:auto;font-size:.8rem;line-height:1.65;color:var(--mlc-fg);background:transparent;border:0;border-radius:0;white-space:pre;tab-size:2}\n.mlc-wrap .mlc-pre code{font:inherit;background:none;padding:0;color:inherit}\n.mlc-wrap .mlc-code-note{margin:0;padding:10px 16px;font-size:.8rem;color:var(--mlc-mfg);border-top:1px solid var(--mlc-border)}\n.mlc-wrap .mlc-code-note a,.mlc-wrap .mlc-note a,.mlc-wrap .mlc-table a,.mlc-wrap .mlc-foot a,.mlc-wrap .mlc-also a{color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-faq{display:grid;gap:10px}\n.mlc-wrap .mlc-faq-item{background:var(--mlc-card);border:1px solid var(--mlc-border);border-radius:16px;padding:0}\n.mlc-wrap .mlc-faq-item summary{cursor:pointer;list-style:none;padding:14px 44px 14px 18px;font-weight:600;position:relative;color:var(--mlc-fg);border-radius:16px}\n.mlc-wrap .mlc-faq-item summary::-webkit-details-marker{display:none}\n.mlc-wrap .mlc-faq-item summary::after{content:\"\";position:absolute;right:20px;top:50%;width:8px;height:8px;border-right:2px solid var(--mlc-accent);border-bottom:2px solid var(--mlc-accent);transform:translateY(-70%) rotate(45deg);transition:transform .15s}\n.mlc-wrap .mlc-faq-item[open] summary::after{transform:translateY(-30%) rotate(225deg)}\n.mlc-wrap .mlc-faq-item p{margin:0;padding:0 18px 16px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-foot{margin:32px 0 0;font-size:.82rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-cta{margin-top:28px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 28px;background:var(--mlc-tint);border:1px solid var(--mlc-accent);border-radius:16px}\n.mlc-wrap .mlc-cta-title{margin:0 0 4px;font-size:1.25rem;font-weight:700;color:var(--mlc-fg)}\n.mlc-wrap .mlc-cta-text{margin:0;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-btn{flex:none;display:inline-block;padding:11px 22px;border-radius:10px;background:var(--mlc-accent);color:#1a1228;font-weight:600;text-decoration:none;border:1px solid var(--mlc-accent);transition:filter .15s}\n.mlc-wrap .mlc-btn:hover{filter:brightness(1.08);color:#1a1228}\n.mlc-wrap .mlc-btns{flex:none;display:flex;flex-wrap:wrap;gap:10px}\n.mlc-wrap .mlc-btn-2{background:transparent;color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-btn-2:hover{background:var(--mlc-card);color:var(--mlc-accent-text)}\n.mlc-wrap .mlc-note{margin:10px 0 0;font-size:.8rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets{margin:0;padding-left:20px;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-bullets li{margin:0 0 10px}\n.mlc-wrap .mlc-bullets strong{color:var(--mlc-fg)}\n.mlc-wrap .mlc-stay,.mlc-wrap .mlc-switch{margin-top:36px}\n.mlc-wrap .mlc-stay{padding:22px;border:1px solid var(--mlc-border);border-radius:14px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:18px 0 4px}\n.mlc-wrap .mlc-move-grid>div{padding:18px;border:1px solid var(--mlc-border);border-radius:12px;background:var(--mlc-card)}\n.mlc-wrap .mlc-move-title{margin:0 0 10px;font-size:1rem}\n.mlc-wrap .mlc-also{margin-top:22px;font-size:.95rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-panel-hero{margin-top:8px}\n.mlc-wrap a:focus-visible,.mlc-wrap summary:focus-visible,.mlc-wrap .mlc-scroll:focus-visible,.mlc-wrap .mlc-pre:focus-visible,.mlc-wrap .mlc-btn:focus-visible{outline:2px solid var(--mlc-accent);outline-offset:2px}\n@container (max-width:720px){.mlc-wrap .mlc-codes{grid-template-columns:1fr}.mlc-wrap .mlc-cta{flex-direction:column;align-items:flex-start;padding:20px}}\n@container (max-width:640px){.mlc-wrap .mlc-move-grid{grid-template-columns:1fr;gap:14px}.mlc-wrap .mlc-stay{padding:18px}}\n@container (max-width:560px){.mlc-wrap .mlc-table{min-width:0;font-size:.9rem}.mlc-wrap .mlc-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.mlc-wrap .mlc-table,.mlc-wrap .mlc-table tbody,.mlc-wrap .mlc-table tr,.mlc-wrap .mlc-table th,.mlc-wrap .mlc-table td{display:block;width:auto}.mlc-wrap .mlc-table tbody tr{border-bottom:1px solid var(--mlc-border);padding:12px 14px}.mlc-wrap .mlc-table tbody tr:last-child{border-bottom:0}.mlc-wrap .mlc-table tbody th{width:auto;padding:0 0 8px;border:0;font-weight:600;color:var(--mlc-fg)}.mlc-wrap .mlc-table tbody td{width:auto;padding:8px 10px;border:0;border-radius:6px}.mlc-wrap .mlc-table tbody td+td{margin-top:6px;background:var(--mlc-muted)}.mlc-wrap .mlc-table tbody td::before{content:attr(data-mlc-label);display:block;font-size:.72rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mlc-mfg);margin-bottom:2px}.mlc-wrap .mlc-pre{font-size:.74rem;padding:14px}}\n.mlc-wrap .mlc-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:18px 0 4px}\n.mlc-wrap .mlc-card{padding:18px;border:1px solid var(--mlc-border);border-radius:14px;background:var(--mlc-card)}\n.mlc-wrap .mlc-card .mlc-move-title{margin:0 0 6px;font-size:1rem;font-weight:600;color:var(--mlc-fg)}\n.mlc-wrap .mlc-card p{margin:0;font-size:.92rem;color:var(--mlc-mfg)}\n.mlc-wrap .mlc-intro code,.mlc-wrap .mlc-card code,.mlc-wrap .mlc-bullets code{font-family:\"Spline Sans Mono\",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.85em;background:var(--mlc-muted);border-radius:6px;padding:1px 5px;color:var(--mlc-fg)}\n.mlc-wrap .mlc-intro a,.mlc-wrap .mlc-card a,.mlc-wrap .mlc-bullets a{color:var(--mlc-accent-text)}\n@container (max-width:860px){.mlc-wrap .mlc-cards{grid-template-columns:1fr 1fr}}\n@container (max-width:560px){.mlc-wrap .mlc-cards{grid-template-columns:1fr}}\n</style>\n<div class=\"mlc-head\"><p class=\"mlc-kicker\">For developers</p><h1 class=\"mlc-h2\">Add file uploads to your app without building the plumbing</h1><p class=\"mlc-lead\">MediaLit is a file upload API for app builders. Drop a React uploader into your frontend, add one signature route to your server, and get resumable browser uploads, thumbnails, private files and automatic cleanup of abandoned uploads.</p></div>\n<section class=\"mlc-panel mlc-panel-hero\">\n<h2 class=\"mlc-h3\">What you get</h2><p class=\"mlc-intro\">Storing user files in a bucket yourself means presigned URLs, CORS rules, thumbnails, a table of what you stored and a job to clean up what nobody used. MediaLit handles that part, and your app makes a few calls.</p><div class=\"mlc-cards\"><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Uploads straight from the browser</h3><p>Your server route hands the browser a one-time upload signature. The file goes from the browser to MediaLit, and your API key stays on your server.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Resumable uploads</h3><p>Uploads use the resumable tus protocol. Set a chunk size and large files go up in pieces, picking up where they left off after a dropped connection.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">No orphaned files</h3><p>Uploads stay temporary until your server seals them. Anything nobody seals is deleted after 24 hours, so abandoned forms don&#39;t leave files behind.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Public and private files</h3><p>Public files get a permanent URL. Private files are served through signed URLs that expire.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Thumbnails at upload</h3><p>MediaLit makes a thumbnail for images and videos when they arrive. Turn on WebP conversion in your app settings to convert uploaded images too.</p></div><div class=\"mlc-card\"><h3 class=\"mlc-move-title\">Every file, listed</h3><p>List files with their details, paginated and filtered by group or access, without keeping your own table of uploads.</p></div></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">Add uploads in three steps</h2><p class=\"mlc-intro\">Add a signature route, render the uploader, and seal the file when the user saves. This example uses Next.js; the same pieces work with <a href=\"/docs/express-js\">Express</a> and <a href=\"/docs/other-frameworks\">other frameworks</a>.</p><div class=\"mlc-codes\" style=\"grid-template-columns:1fr\"><figure class=\"mlc-code\"><figcaption class=\"mlc-code-head\"><span>Next.js app</span><span class=\"mlc-chip\">Next.js + React</span></figcaption><pre class=\"mlc-pre\" tabindex=\"0\"><code>// .env (server only)\n// MEDIALIT_API_KEY=...\n\n// app/api/medialit/signature/route.ts\nimport { createSignatureHandler } from &quot;medialit&quot;;\n\nexport const POST = createSignatureHandler({\n  // Reads MEDIALIT_API_KEY from the environment.\n  authorize: async () =&gt; !!(await getSession()), // your app&#x27;s auth\n});\n\n// components/avatar-upload.tsx\n&quot;use client&quot;;\nimport { MediaLitUploader } from &quot;@medialit/react&quot;;\nimport &quot;@medialit/react/styles.css&quot;;\n\nexport function AvatarUpload() {\n  return (\n    &lt;MediaLitUploader\n      signatureEndpoint=&quot;/api/medialit/signature&quot;\n      access=&quot;public&quot;\n      accept=&quot;image/*&quot;\n      onUploadComplete={(media) =&gt; setAvatarId(media.mediaId)}\n    /&gt;\n  );\n}\n\n// app/actions.ts (runs on your server when the user clicks Save)\n&quot;use server&quot;;\nimport { MediaLit } from &quot;medialit&quot;;\n\nexport async function saveAvatar(mediaId: string) {\n  const media = await new MediaLit().seal(mediaId); // keep it\n  await db.user.update({ avatarUrl: media.file });\n}</code></pre><p class=\"mlc-code-note\">Install with <code>npm install medialit @medialit/react</code>. The <code>medialit</code> SDK only runs on your server; the browser only ever sees a signature.</p></figure></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">Works with your stack</h2><ul class=\"mlc-bullets\"><li><strong>React:</strong> the <code>&lt;MediaLitUploader&gt;</code> component, or the <code>useMediaLitUpload</code> hook to build your own UI. <a href=\"/docs/react\">React guide</a></li><li><strong>Node.js:</strong> the <code>medialit</code> SDK uploads, lists, seals and deletes files from your server. <a href=\"/docs/node-sdk\">Node.js SDK</a></li><li><strong>Anything else:</strong> <code>@medialit/uploader</code> for resumable uploads, or the REST API directly. <a href=\"/docs/other-frameworks\">Other frameworks</a></li><li><strong>Your own buckets:</strong> self-host MediaLit on AWS S3, Cloudflare R2 or MinIO with the same API. <a href=\"/docs/self-hosting\">Self-hosting guide</a></li></ul><div class=\"mlc-stay\"><h2 class=\"mlc-h3\">What it doesn&#39;t do</h2><ul class=\"mlc-bullets\"><li>No resizing or cropping through the URL. Images get one thumbnail at upload; generate other sizes yourself and upload them as files.</li><li>No video transcoding or adaptive streaming. Videos are stored and served as uploaded.</li><li>No fetching files from other sites. Files only arrive through an upload made with your API key or a signature.</li><li>WebP conversion replaces the original image rather than keeping both.</li><li>File size is capped by your plan: 50 MB on Basic, 2 GB on Pro.</li></ul></div><h2 class=\"mlc-h3\" style=\"margin-top:44px\">Pricing</h2><p class=\"mlc-intro\">Basic is free with 1 GB of storage and files up to 50 MB. Pro is $10/mo or $100/yr for 100 GB and files up to 2 GB. Storage is what you pay for.</p>\n<div class=\"mlc-cta\"><div><p class=\"mlc-cta-title\">Add uploads to your app today</p><p class=\"mlc-cta-text\">Basic is free with 1 GB. Create an API key and follow the quick start.</p></div><div class=\"mlc-btns\"><a class=\"mlc-btn\" href=\"https://app.medialit.cloud/login\">Start free</a><a class=\"mlc-btn mlc-btn-2\" href=\"/docs/quick-start\">Read the quick start</a></div></div>\n<p class=\"mlc-also\">Also see: <a href=\"/agent-storage\">file storage for AI agents</a> · <a href=\"/file-storage\">file storage for businesses</a> · <a href=\"/compare-uploadthing\">MediaLit vs UploadThing</a> · <a href=\"/compare-cloudinary\">MediaLit vs Cloudinary</a> · <a href=\"/compare#s3\">MediaLit vs Amazon S3</a></p>\n</section>\n<p class=\"mlc-foot\">Plan limits are from <a href=\"https://medialit.cloud/#pricing\">medialit.cloud</a>. MediaLit is open source: the client packages are MIT and the server is AGPL. Spotted something out of date? <a href=\"https://github.com/codelitdev/medialit/issues\">Open an issue</a>.</p>\n</div>"
      }
    }
  ]
}
