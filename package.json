    "body-parser@>=2.0.0 <3.0.0": "2.3.0",
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "browserslist@>=4.0.0 <5.0.0": "4.28.7",
    "diff@>=4.0.0 <5.0.0": "4.0.4",
    "fast-uri@>=3.0.0 <4.0.0": "3.1.8",
    "fast-xml-builder@>=1.0.0 <2.0.0": "1.1.7",
    "fast-xml-parser@>=5.0.0 <6.0.0": "5.7.0",
    "flatted@>=3.0.0 <4.0.0": "3.4.2",
    "form-data@>=2.0.0 <3.0.0": "2.5.6",
    "form-data@>=4.0.0 <5.0.0": "4.0.6",
    "glob@>=10.0.0 <11.0.0": "10.5.0",
    "hono@>=4.0.0 <5.0.0": "4.13.7",
    "image-size@>=2.0.0 <3.0.0": "2.0.3",
    "ip-address@>=10.0.0 <11.0.0": "10.7.1",
    "joi@>=17.0.0 <18.0.0": "17.13.7",
    "js-yaml@>=3.0.0 <4.0.0": "3.15.2",
    "js-yaml@>=4.0.0 <5.0.0": "4.3.2",
    "jws@>=3.0.0 <4.0.0": "3.2.3",
    "lodash@>=4.0.0 <5.0.0": "4.18.0",
    "mdast-util-to-hast@>=13.0.0 <14.0.0": "13.2.1",
    "minimatch@>=3.0.0 <4.0.0": "3.1.4",
    "minimatch@>=9.0.0 <10.0.0": "9.0.7",
    "nanoid@>=3.0.0 <4.0.0": "3.3.18",
    "next@>=16.0.0 <17.0.0": "16.3.6",
    "path-to-regexp@>=0.1.0 <0.2.0": "0.1.13",
    "path-to-regexp@>=8.0.0 <9.0.0": "8.4.0",
    "picomatch@>=2.0.0 <3.0.0": "2.3.2",
