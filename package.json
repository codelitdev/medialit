{
  "name": "medialit",
  "private": true,
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@next/eslint-plugin-next": "^15.2.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.2.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "scripts": {
    "prepare": "husky",
    "ci:publish": "bunx changeset publish",
    "test": "bun run --filter @medialit/api test && bun run --filter medialit test && bun run --filter @medialit/uploader test && bun run --filter @medialit/react test && bun run --filter @medialit/cli test",
    "lint": "eslint --cache --quiet",
    "prettier": "prettier --check **/*.{ts,tsx,js,css,md}",
    "lint:fix": "eslint --cache --fix",
    "prettier:fix": "prettier --write **/*.{ts,tsx,js,css,md}",
    "release": "./release.sh",
    "dev:api": "bun --filter @medialit/api dev",
    "dev:web": "bun --filter @medialit/web dev --port 3007",
    "dev:docs": "bun --filter @medialit/docs dev --port 3008",
    "test:integration": "bun --filter @medialit/integration-tests test:integration",
    "test:integration:stack": "bash packages/integration-tests/scripts/run-with-local-stack.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,js,css,md}": "prettier --write"
  },
  "overrides": {
    "@babel/core@>=7.0.0 <8.0.0": "7.29.6",
    "@eslint/plugin-kit@>=0.2.0 <0.3.0": "0.3.5",
    "@hono/node-server@>=1.0.0 <2.0.0": "1.19.15",
    "@humanfs/node@>=0.16.0 <0.17.0": "0.16.8",
    "ajv@>=6.0.0 <7.0.0": "6.14.0",
    "baseline-browser-mapping@>=2.0.0 <3.0.0": "2.11.0",
