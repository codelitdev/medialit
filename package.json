    "postcss@>=8.0.0 <9.0.0": "8.5.23",
    "postcss-selector-parser@>=6.0.0 <7.0.0": "6.1.3",
    "postcss-selector-parser@>=7.0.0 <8.0.0": "7.1.3",
    "qs@>=6.0.0 <7.0.0": "6.16.0",
    "rollup@>=4.0.0 <5.0.0": "4.59.0",
    "tmp@>=0.0.0 <1.0.0": "0.2.7",
    "ws@>=5.0.0 <6.0.0": "5.2.5",
    "yaml@>=2.0.0 <3.0.0": "2.8.3"
  },
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ]
}
