{
  "name": "@medialit/uploader",
  "version": "0.1.0",
  "description": "Resumable browser uploads to MediaLit",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test '__tests__/**/*.test.ts'",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "medialit",
    "upload",
    "tus",
    "resumable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codelitdev/medialit"
  },
  "dependencies": {
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.1"
}
